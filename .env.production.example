# Public API endpoint that mobile/web clients will use
PUBLIC_BASE_URL=https://api.example.com

# Server/runtime
PORT=3001
ENABLE_WEB_FALLBACK=0
STREAM_FETCH_TIMEOUT_MS=15000
IPTV_FETCH_TIMEOUT_MS=15000
IPTV_REFRESH_MINUTES=30

# Persisted IPTV files (cache + health)
IPTV_DATA_DIR=/var/data

# Optional explicit Chrome path in Linux containers
CHROME_PATH=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: explicit source file path
# IPTV_SOURCES_FILE=/app/iptv-sources.json
